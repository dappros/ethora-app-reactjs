VITE_API=https://api.chat.ethora.com/v1
VITE_API_V2=https://api.chat.ethora.com/v2
VITE_DOMAIN_NAME=ethora
VITE_ROOT_DOMAIN=ethora.com
VITE_SITE_IS_PRODUCTION=true
VITE_STRIPE_PUBLICK_KEY=pk_test_iTgKAZ1WZinSX7NI1UTveLVu

VITE_APP_ALLOWED_DOMAINS=app.chat.ethora.com,localhost

# Web push (FCM). Required for chat push notifications on the domains listed
# in VITE_APP_ALLOWED_DOMAINS. Leave blank to keep push disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# VAPID public key from Firebase Console > Cloud Messaging > Web Push
# certificates. Required for the browser to obtain an FCM token.
VITE_VAPID_PUBLIC_KEY=

# Video/audio calls (LiveKit). When 'true', the chat-component videoCalls
# switch is enabled. No effect unless the chat-component build ships the
# calls feature. Disabled by default.
VITE_VIDEO_CALLS_ENABLED=false
# LiveKit server URL (required when video calls are enabled).
VITE_LIVEKIT_URL=
VITE_QR_URL=https://app.chat.ethora.com/app/chat/?qrChatId=

# Message translation endpoint (optional). When set, an on-demand "Translate"
# link appears under incoming messages in a different language. It receives a
# POST { text, source, target } and must return { translatedText }. Point it at
# your own service (or a proxy to Google Translate / OpenAI). Leave empty to
# disable dynamic translation. Static UI captions (en/fr/es) work regardless,
# driven by the device language.
VITE_TRANSLATE_ENDPOINT=

VITE_CLARITY_ID=q85va6v8yj
VITE_GTM_ID=GTM-NTMFZ8P
VITE_GA_ID=G-M8SFB5QEGX

VITE_APP_XMPP_SERVICE=wss://xmpp.chat.ethora.com:5443/ws
VITE_XMPP_SERVICE=conference.xmpp.chat.ethora.com
VITE_XMPP_HOST=xmpp.chat.ethora.com

# Unlocks the AI Widget tab. Must be the literal string "true"; anything
# else leaves the tab disabled and the panel in read-only preview mode.
VITE_AI_FEATURE_ENABLED=true

# --- AI Widget bundle (OPTIONAL, dev only) ---
# Nothing here needs setting, and in a production build nothing here is used.
# The widget is a pinned dependency (@ethora/ai-chat-widget in package.json);
# `npm run build` copies its bundle into public/widget/ and the admin serves it
# from its own origin. The version that ships is decided by package-lock.json,
# so a leftover value below cannot point the product at a bundle nobody
# deployed - which is exactly how QA ended up serving assistant2604.js.
#
# Under `npm run dev` these still apply, for working against the widget's
# CURRENT source with no build step:
#   cd ../ai-assistant-ui && npm run dev        # serves on :5173
#   VITE_WIDGET_URL=http://localhost:5173/src/main.tsx
# The admin detects the .tsx entry and loads it as an ES module, so unreleased
# widget changes appear immediately. VITE_WIDGET_VERSIONED_URL wins over
# VITE_WIDGET_URL when both are set.
VITE_WIDGET_URL=
VITE_WIDGET_VERSIONED_URL=

# Environment variables for diagnostic probes. Copy to `.env.local` (gitignored)
# and `source .env.local` before running, or pass them inline:
#
#   QA_BASE=https://app.chat-qa.ethora.com node tests/diagnostics/chat-spinner-probe.mjs

# Frontend URL of the environment to probe.
QA_BASE=https://app.chat-qa.ethora.com

# Backend API URL (used for direct signup/login bypassing the UI).
QA_API=https://api.chat-qa.ethora.com

# AppId of the base app on the target environment. Read from
# https://${QA_API}/v1/apps/get-config?domainName=app -> result._id
APP_ID=646cc8dc96d4a4dc8f7b2f2d

# Test account credentials. Will be created on first run, reused after.
# Use a distinct email per developer to avoid stepping on each other.
TEST_EMAIL=test01@test.ethora.com
TEST_PASSWORD=TestPass123!

# Where to save the post-spinner screenshot.
SCREENSHOT_PATH=/tmp/chat-spinner-probe.png

# How long to wait on /app/chat before snapshotting state. Default 12s.
# Bump this if the chat takes longer than that to come online (e.g. on
# a cold backend).
WAIT_MS=12000
